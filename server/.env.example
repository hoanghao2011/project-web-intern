NODE_ENV=development
PORT=5001
# MongoDB phải chạy dưới dạng replica set (kể cả single-node) để hỗ trợ transaction.
# Local: mongod --replSet rs0, sau đó chạy "mongosh --eval 'rs.initiate()'" một lần.
MONGO_URI=mongodb://127.0.0.1:27017/equipment_management_intern?replicaSet=rs0
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5174
